[Unit]
Description=Shrimp Cam MJPEG streaming web app
After=network-online.target
Wants=network-online.target

[Service]
# Adjust User and paths if you cloned somewhere else or use a different user.
User=pi
WorkingDirectory=/home/pi/raspi-video-stream
# Use the system Python so it can see the apt-installed python3-picamera2.
ExecStart=/usr/bin/python3 /home/pi/raspi-video-stream/app.py
Environment=PORT=8080
# Uncomment to require a username/password (recommended when internet-facing):
# Environment=SHRIMPCAM_USER=yourname
# Environment=SHRIMPCAM_PASS=a-long-random-password
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
