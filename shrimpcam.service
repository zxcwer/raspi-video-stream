[Unit]
Description=Shrimp Cam MJPEG streaming web app
After=network-online.target
Wants=network-online.target

[Service]
# NOTE: __USER__ and __DIR__ are placeholders. Either run ./install-service.sh,
# which fills them in with your real username and repo path, or replace them by
# hand before copying this file to /etc/systemd/system/.
#
# A wrong username here causes: status=217/USER "Failed at step USER".
User=__USER__
WorkingDirectory=__DIR__
# Use the system Python so it can see the apt-installed python3-picamera2.
ExecStart=/usr/bin/python3 __DIR__/app.py
Environment=PORT=8080
# Uncomment to require a username/password (recommended when internet-facing):
# Environment=SHRIMPCAM_USER=yourname
# Environment=SHRIMPCAM_PASS=a-long-random-password
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
